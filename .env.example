# Required. Generate a secret with GENERATE_SECRET.cmd or GENERATE_SECRET.ps1.
RELAY_API_KEY=replace-with-a-long-random-secret

# Safest setting: comma-separated exact hosts or wildcard subdomains.
ALLOWED_HOSTS=example.com,api.example.com,*.example.org

# Keep false unless you fully understand the abuse and usage risks.
ALLOW_ANY_PUBLIC_HOST=false

# Optional exact browser origin for cross-origin API calls.
ALLOWED_ORIGIN=

RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=15000
MAX_REQUEST_BYTES=524288
MAX_RESPONSE_BYTES=3145728
MAX_REDIRECTS=4
